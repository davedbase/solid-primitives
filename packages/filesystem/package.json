{
  "name": "@solid-primitives/filesystem",
  "version": "3.0.0-next.5",
  "description": "A primitive for convenient file system access.",
  "author": "Alex Lohr <alex.lohr@logmein.com>",
  "contributors": [],
  "license": "MIT",
  "homepage": "https://primitives.solidjs.community/package/filesystem",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/solidjs-community/solid-primitives.git"
  },
  "bugs": {
    "url": "https://github.com/solidjs-community/solid-primitives/issues"
  },
  "primitive": {
    "name": "filesystem",
    "stage": 3,
    "list": [
      "createFileSystem",
      "createSyncFileSystem",
      "createAsyncFileSystem",
      "makeNoFileSystem",
      "makeNoAsyncFileSystem",
      "makeVirtualFileSystem",
      "makeWebAccessFileSystem",
      "makeNodeFileSystem",
      "makeTauriFileSystem",
      "makeChokidarWatcher",
      "rsync"
    ],
    "category": "Display & Media",
    "gzip": 3613
  },
  "keywords": [
    "solid",
    "primitives"
  ],
  "private": false,
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "type": "module",
  "module": "./dist/index.js",
  "browser": {},
  "types": "./dist/index.d.ts",
  "exports": {
    "import": {
      "@solid-primitives/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "tsdown": {
    "entry": "src/**/*.{ts,tsx}",
    "outDir": "dist"
  },
  "scripts": {
    "dev": "node --import=@nothing-but/node-resolve-ts --experimental-transform-types ../../scripts/dev.ts",
    "build": "pnpm -w build",
    "vitest": "vitest -c ../../configs/vitest.config.ts",
    "test": "pnpm run vitest",
    "test:ssr": "pnpm run vitest --mode ssr"
  },
  "devDependencies": {
    "@solidjs/web": "catalog:",
    "@tauri-apps/api": "^1.6.0",
    "@types/wicg-file-system-access": "2023.10.7",
    "chokidar": "^3.6.0",
    "solid-js": "catalog:peer"
  },
  "peerDependencies": {
    "@solidjs/web": "catalog:peer",
    "chokidar": "^3.5.3",
    "solid-js": "catalog:peer"
  },
  "peerDependenciesMeta": {
    "chokidar": {
      "optional": true
    }
  },
  "typesVersions": {}
}
