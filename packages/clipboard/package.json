{
  "name": "@solid-primitives/clipboard",
  "version": "2.0.0-next.19",
  "description": "Primitives for reading and writing to clipboard.",
  "author": "David Di Biase <dave@solidjs.com>",
  "contributors": [
    "Damian Tarnawski <gthetarnav@gmail.com>"
  ],
  "license": "MIT",
  "homepage": "https://primitives.solidjs.community/package/clipboard",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/solidjs-community/solid-primitives.git"
  },
  "primitive": {
    "name": "clipboard",
    "stage": 3,
    "list": [
      "copyClipboard",
      "writeClipboard",
      "createClipboard"
    ],
    "category": "Browser APIs",
    "gzip": 919
  },
  "files": [
    "dist"
  ],
  "private": false,
  "sideEffects": false,
  "type": "module",
  "module": "./dist/index.js",
  "browser": {},
  "types": "./dist/index.d.ts",
  "exports": {
    "import": {
      "@solid-primitives/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "tsdown": {
    "entry": "src/**/*.{ts,tsx}",
    "outDir": "dist"
  },
  "scripts": {
    "start": "vite serve dev",
    "dev": "node --import=@nothing-but/node-resolve-ts ../../scripts/dev.ts",
    "build": "pnpm -w build",
    "vitest": "vitest -c ../../configs/vitest.config.ts",
    "test": "pnpm run vitest",
    "test:ssr": "pnpm run vitest --mode ssr"
  },
  "keywords": [
    "clipboard",
    "copy",
    "paste",
    "clipboard data",
    "solid",
    "primitives"
  ],
  "testEnvironment": "jsdom",
  "dependencies": {
    "@solid-primitives/utils": "workspace:^"
  },
  "peerDependencies": {
    "@solidjs/web": "catalog:peer",
    "solid-js": "catalog:peer"
  },
  "typesVersions": {},
  "devDependencies": {
    "@solidjs/web": "catalog:",
    "solid-js": "catalog:peer"
  }
}
