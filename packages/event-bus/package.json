{
  "name": "@solid-primitives/event-bus",
  "version": "3.0.0-next.5",
  "description": "A collection of primitives providing various features of a pubsub/event-emitter/event-bus.",
  "author": "Damian Tarnawski @thetarnav <gthetarnav@gmail.com>",
  "license": "MIT",
  "homepage": "https://primitives.solidjs.community/package/event-bus",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/solidjs-community/solid-primitives.git"
  },
  "primitive": {
    "name": "event-bus",
    "stage": 3,
    "list": [
      "createEventBus",
      "createEmitter",
      "createEventHub",
      "createEventStack"
    ],
    "category": "Utilities",
    "gzip": 1059
  },
  "private": false,
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "type": "module",
  "module": "./dist/index.js",
  "browser": {},
  "types": "./dist/index.d.ts",
  "exports": {
    "import": {
      "@solid-primitives/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "tsdown": {
    "entry": "src/**/*.{ts,tsx}",
    "outDir": "dist"
  },
  "scripts": {
    "start": "vite serve dev",
    "dev": "node --import=@nothing-but/node-resolve-ts ../../scripts/dev.ts",
    "build": "pnpm -w build",
    "vitest": "vitest -c ../../configs/vitest.config.ts",
    "test": "pnpm run vitest",
    "test:ssr": "pnpm run vitest --mode ssr"
  },
  "keywords": [
    "eventbus",
    "pubsub",
    "event",
    "emitter",
    "solid",
    "primitives"
  ],
  "dependencies": {
    "@solid-primitives/utils": "workspace:^"
  },
  "peerDependencies": {
    "solid-js": "catalog:peer"
  },
  "typesVersions": {},
  "devDependencies": {
    "solid-js": "catalog:peer"
  }
}
