{
  "name": "@solid-primitives/scheduled",
  "version": "2.0.0-next.4",
  "description": "Primitives for creating scheduled — throttled or debounced — callbacks.",
  "contributors": [
    "David Di Biase <dave@solidjs.com>",
    "Damian Tarnawski <gthetarnav@gmail.com>",
    "Jonathan Frere <jonathan.frere@esveo.com>"
  ],
  "license": "MIT",
  "homepage": "https://primitives.solidjs.community/package/scheduled",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/solidjs-community/solid-primitives.git"
  },
  "bugs": {
    "url": "https://github.com/solidjs-community/solid-primitives/issues"
  },
  "primitive": {
    "name": "scheduled",
    "stage": 3,
    "list": [
      "debounce",
      "throttle",
      "scheduleIdle",
      "leading",
      "createScheduled",
      "leadingAndTrailing"
    ],
    "category": "Utilities",
    "gzip": 671
  },
  "private": false,
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "browser": {},
  "exports": {
    "import": {
      "@solid-primitives/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "tsdown": {
    "entry": "src/**/*.{ts,tsx}",
    "outDir": "dist"
  },
  "scripts": {
    "dev": "node --import=@nothing-but/node-resolve-ts ../../scripts/dev.ts",
    "build": "pnpm -w build",
    "vitest": "vitest -c ../../configs/vitest.config.ts",
    "test": "pnpm run vitest",
    "test:ssr": "pnpm run vitest --mode ssr"
  },
  "keywords": [
    "solid",
    "primitives",
    "scheduled",
    "debounce",
    "throttle"
  ],
  "devDependencies": {
    "@solid-primitives/event-listener": "workspace:^",
    "@solid-primitives/timer": "workspace:^",
    "@solidjs/web": "catalog:",
    "solid-js": "catalog:peer"
  },
  "peerDependencies": {
    "@solidjs/web": "catalog:peer",
    "solid-js": "catalog:peer"
  },
  "typesVersions": {}
}
