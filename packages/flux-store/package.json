{
  "name": "@solid-primitives/flux-store",
  "version": "1.0.0-next.4",
  "description": "Primitive to simplify the creation of global stores and the ability to access and mutate them.",
  "author": "Zalexios <zalexios@outlook.com>",
  "contributors": [],
  "license": "MIT",
  "homepage": "https://primitives.solidjs.community/package/flux-store",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/solidjs-community/solid-primitives.git"
  },
  "bugs": {
    "url": "https://github.com/solidjs-community/solid-primitives/issues"
  },
  "primitive": {
    "name": "flux-store",
    "stage": 3,
    "list": [
      "createFluxStore",
      "createFluxStoreFactory",
      "createActions",
      "createAction"
    ],
    "category": "Utilities",
    "gzip": 263
  },
  "keywords": [
    "solid",
    "provider",
    "context",
    "store",
    "state",
    "primitives",
    "flux"
  ],
  "private": false,
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "type": "module",
  "module": "./dist/index.js",
  "browser": {},
  "types": "./dist/index.d.ts",
  "exports": {
    "import": {
      "@solid-primitives/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "tsdown": {
    "entry": "src/**/*.{ts,tsx}",
    "outDir": "dist"
  },
  "scripts": {
    "dev": "node --import=@nothing-but/node-resolve-ts ../../scripts/dev.ts",
    "build": "pnpm -w build",
    "vitest": "vitest -c ../../configs/vitest.config.ts",
    "test": "pnpm run vitest",
    "test:ssr": "pnpm run vitest --mode ssr"
  },
  "peerDependencies": {
    "solid-js": "catalog:peer"
  },
  "typesVersions": {},
  "devDependencies": {
    "solid-js": "catalog:peer"
  }
}
