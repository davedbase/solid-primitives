{
  "name": "@solid-primitives/workers",
  "version": "2.0.1-next.3",
  "description": "Primitives that support creating Web Workers.",
  "author": "David Di Biase <dave@solidjs.com>",
  "license": "MIT",
  "homepage": "https://primitives.solidjs.community/package/workers",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/solidjs-community/solid-primitives.git"
  },
  "primitive": {
    "name": "workers",
    "stage": 2,
    "list": [
      "createWorker",
      "createWorkerPool",
      "createWorkerQuery",
      "createReactiveWorker",
      "workerScope"
    ],
    "category": "Browser APIs",
    "gzip": 1401
  },
  "files": [
    "dist"
  ],
  "private": false,
  "sideEffects": false,
  "type": "module",
  "module": "./dist/index.js",
  "browser": {},
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "@solid-primitives/source": "./src/index.ts",
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./worker": {
      "import": {
        "@solid-primitives/source": "./src/worker-scope.ts",
        "types": "./dist/worker-scope.d.ts",
        "default": "./dist/worker-scope.js"
      }
    }
  },
  "tsdown": {
    "entry": "src/**/*.{ts,tsx}",
    "outDir": "dist"
  },
  "scripts": {
    "dev": "node --import=@nothing-but/node-resolve-ts --experimental-transform-types ../../scripts/dev.ts",
    "build": "pnpm -w build",
    "vitest": "vitest -c ../../configs/vitest.config.ts",
    "test": "pnpm run vitest",
    "test:ssr": "pnpm run vitest --mode ssr"
  },
  "keywords": [
    "worker",
    "web worker",
    "shared worker",
    "primitives"
  ],
  "peerDependencies": {
    "@solidjs/web": "catalog:peer",
    "solid-js": "catalog:peer"
  },
  "typesVersions": {},
  "devDependencies": {
    "@solidjs/web": "catalog:",
    "solid-js": "catalog:peer"
  }
}
