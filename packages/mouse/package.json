{
  "name": "@solid-primitives/mouse",
  "version": "4.0.0-next.5",
  "description": "A collection of primitives that capture current mouse cursor position, and help to deal with common related usecases.",
  "author": "Damian Tarnawski <gthetarnav@gmail.com>",
  "license": "MIT",
  "homepage": "https://primitives.solidjs.community/package/mouse",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/solidjs-community/solid-primitives.git"
  },
  "primitive": {
    "name": "mouse",
    "stage": 3,
    "list": [
      "createMousePosition",
      "createPositionToElement"
    ],
    "category": "Inputs",
    "gzip": 1760
  },
  "sideEffects": false,
  "private": false,
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "browser": {},
  "exports": {
    "import": {
      "@solid-primitives/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "tsdown": {
    "entry": "src/**/*.{ts,tsx}",
    "outDir": "dist"
  },
  "scripts": {
    "dev": "node --import=@nothing-but/node-resolve-ts --experimental-transform-types ../../scripts/dev.ts",
    "build": "pnpm -w build",
    "vitest": "vitest -c ../../configs/vitest.config.ts",
    "test": "pnpm run vitest",
    "test:ssr": "pnpm run vitest --mode ssr",
    "test:watch": "watchlist src test -- npm test"
  },
  "keywords": [
    "mouse",
    "touch",
    "cursor",
    "solid",
    "primitives"
  ],
  "devDependencies": {
    "@solid-primitives/raf": "workspace:^",
    "@solidjs/web": "catalog:",
    "solid-js": "catalog:peer"
  },
  "dependencies": {
    "@solid-primitives/event-listener": "workspace:^",
    "@solid-primitives/rootless": "workspace:^",
    "@solid-primitives/static-store": "workspace:^",
    "@solid-primitives/utils": "workspace:^"
  },
  "peerDependencies": {
    "@solidjs/web": "catalog:peer",
    "solid-js": "catalog:peer"
  },
  "typesVersions": {}
}
