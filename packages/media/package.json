{
  "name": "@solid-primitives/media",
  "version": "4.0.0-next.6",
  "description": "Primitives for media query and device features",
  "author": "David Di Biase <dave@solidjs.com>",
  "contributors": [
    {
      "name": "Aditya Agarwal",
      "email": "adityaa803@gmail.com",
      "url": "https://devadi.netlify.app"
    },
    "Damian Tarnawski <gthetarnav@gmail.com>",
    "Tom Pichaud <dev.tompichaud@icloud.com>"
  ],
  "license": "MIT",
  "homepage": "https://primitives.solidjs.community/package/media",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/solidjs-community/solid-primitives.git"
  },
  "primitive": {
    "name": "media",
    "stage": 3,
    "list": [
      "makeMediaQueryListener",
      "createMediaQuery",
      "createBreakpoints",
      "usePrefersDark"
    ],
    "category": "Display & Media",
    "gzip": 1306
  },
  "keywords": [
    "media",
    "mediaquery",
    "query",
    "breakpoints",
    "responsive",
    "solid",
    "primitives"
  ],
  "files": [
    "dist"
  ],
  "private": false,
  "sideEffects": false,
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "browser": {},
  "exports": {
    "import": {
      "@solid-primitives/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "tsdown": {
    "entry": "src/**/*.{ts,tsx}",
    "outDir": "dist"
  },
  "scripts": {
    "dev": "node --import=@nothing-but/node-resolve-ts --experimental-transform-types ../../scripts/dev.ts",
    "build": "pnpm -w build",
    "vitest": "vitest -c ../../configs/vitest.config.ts",
    "test": "pnpm run vitest",
    "test:ssr": "pnpm run vitest --mode ssr"
  },
  "dependencies": {
    "@solid-primitives/event-listener": "workspace:^",
    "@solid-primitives/rootless": "workspace:^",
    "@solid-primitives/static-store": "workspace:^",
    "@solid-primitives/utils": "workspace:^"
  },
  "peerDependencies": {
    "@solidjs/web": "catalog:peer",
    "solid-js": "catalog:peer"
  },
  "typesVersions": {},
  "devDependencies": {
    "@solidjs/web": "catalog:",
    "solid-js": "catalog:peer"
  }
}
